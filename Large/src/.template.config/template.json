{
  "$schema": "http://json.schemastore.org/template",
  "author": "Zohaib Khan",
  "classifications": [ "Web", "Clean Architecture", "Layered Architecture" ],
  "identity": "ZMA.Large.Template",
  "name": "ZMA Large Layered Architecture",
  "shortName": "zma-large",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "ZMALarge",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "net6.0", "description": "Target .NET 6" },
        { "choice": "net7.0", "description": "Target .NET 7" },
        { "choice": "net8.0", "description": "Target .NET 8" },
        { "choice": "net9.0", "description": "Target .NET 9" }
      ],
      "defaultValue": "net8.0"
    }
  },
  "primaryOutputs": [
    { "path": "ZMALarge.sln" }
  ]
}
