<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>ZMA.Small.Template</PackageId>
    <Version>1.0.0</Version>
    <Authors>Zohaib Khan</Authors>
    <TargetFramework>net8.0</TargetFramework>
    <Description>ZMA Hybrid Architecture Template</Description>
    <PackageOutputPath>nupkg</PackageOutputPath>

    <!-- Prevent compilation -->
    <BuildOutputTargetFolder />
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package readme at root (not under content/) -->
    <None Include="readme.md" Pack="true" PackagePath="\" />

    <!-- Include all template content, excluding build artifacts -->
    <None Include="**\*" Pack="true" PackagePath="content"
          Exclude="**\bin\**;**\obj\**;**\.vs\**;nupkg\**;readme.md" />
  </ItemGroup>
</Project>
