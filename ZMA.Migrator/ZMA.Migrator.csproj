<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zma-migrate</ToolCommandName>
    <PackageId>ZMA.Migrator</PackageId>
    <Version>1.0.4</Version>
    <Title>ZMA Hybrid Architecture Migrator</Title>
    <Authors>Zohaib Khan</Authors>
    <Description>Migrate ZMA projects between architectural tiers: Small (monolith) ↔ Medium (modular monolith) ↔ Large (microservices).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zohaib-khan-786/ZK-Hybrid-Architecture</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zohaib-khan-786/ZK-Hybrid-Architecture</RepositoryUrl>
    <PackageTags>zma;hybrid-architecture;migration;monolith;microservices;modular-monolith;clean-architecture</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZMA.Licensing\ZMA.Licensing.csproj" />
  </ItemGroup>

</Project>
