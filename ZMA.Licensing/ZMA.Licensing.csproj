<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>ZMA.Licensing</PackageId>
    <Version>1.0.0</Version>
    <Title>ZMA Hybrid Architecture Licensing</Title>
    <Authors>Zohaib Khan</Authors>
    <Description>License validation client for ZMA Toolkit — server-side validation, offline caching, machine fingerprinting.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zohaib-khan-786/ZK-Hybrid-Architecture</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zohaib-khan-786/ZK-Hybrid-Architecture</RepositoryUrl>
    <PackageTags>zma;licensing;validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
